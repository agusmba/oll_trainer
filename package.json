{
  "name": "oll_trainer-tests",
  "private": true,
  "description": "Dev-only tooling for the OLL Trainer app: headless browser tests and the cache-busting version helper. Not part of the shipped app.",
  "scripts": {
    "test": "node --test test/",
    "test:live": "OLL_LIVE_URL=https://agusmba.github.io/oll_trainer/ node --test test/live.test.mjs",
    "browser:install": "playwright install chromium-headless-shell",
    "bump-version": "node dev/bump-version.mjs",
    "bump-version:check": "node dev/bump-version.mjs --check"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
